{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubtextD1QueryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "group_id",
    "text",
    "fine_labels",
    "broad_labels",
    "is_compound",
    "extraction",
    "spans",
    "provenance"
  ],
  "properties": {
    "query_id": { "type": "string", "minLength": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "fine_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "broad_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "is_compound": { "type": "boolean" },
    "extraction": { "$ref": "extraction.schema.json" },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "start", "end"],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "actor",
              "director",
              "genre",
              "era",
              "language_country",
              "excluded_genre",
              "excluded_term",
              "reference_title"
            ]
          },
          "value": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "collection_batch",
        "is_synthetic",
        "annotation_method",
        "reviewed_by",
        "review_status",
        "revision"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "collection_batch": { "type": "string", "minLength": 1 },
        "is_synthetic": { "type": "boolean" },
        "annotation_method": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "enum": ["approved", "draft", "rejected"] },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
