# Course-only tracking and DVC storage (never point to production stores)
MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub_username>
MLFLOW_TRACKING_PASSWORD=<dagshub_token>

# DVC remote storage credentials (S3 prefix or DagsHub storage)
DVC_REMOTE_NAME=origin
AWS_ACCESS_KEY_ID=<course_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<course_aws_secret_access_key>
AWS_DEFAULT_REGION=us-east-1

# Isolated course application database and corpus
DATABASE_URL=postgresql://user:password@localhost:5432/subtext_course
JWT_SECRET_KEY=<course_only_jwt_secret>
ADMIN_SECRET=<course_only_admin_secret>
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional selective LLM fallback provider (Deliverable 2)
LLM_PROVIDER_BASE_URL=https://api.example.com/v1
LLM_API_KEY=<course_only_llm_api_key>
LLM_MODEL_ID=<pinned_model_id>
